# Copy to .env and fill in real values. Everything here is a placeholder —
# never commit a real .env file.

# --- Core ---
DATABASE_URL="postgresql://stars:stars@localhost:5432/stars_dev"
NEXTAUTH_SECRET="replace-with-a-random-32-byte-secret"
NEXTAUTH_URL="http://localhost:3000"

# --- Cache / queues (Phase 2+) ---
REDIS_URL="redis://localhost:6379"

# --- Object storage (Phase 2+, S3-compatible) ---
STORAGE_ENDPOINT=""
STORAGE_BUCKET=""
STORAGE_ACCESS_KEY_ID=""
STORAGE_SECRET_ACCESS_KEY=""

# --- AI adapter (Phase 4+) — leave unset to keep using the demo AI adapter ---
ANTHROPIC_API_KEY=""

# --- Billing — leave unset to keep checkout/portal disabled (billing page
# still renders, with an explanatory notice). Plan and credit-pack prices are
# sent to Stripe inline (price_data) from src/config/pricing.ts — no need to
# pre-create Products/Prices in the Stripe Dashboard. Use a TEST mode secret
# key (sk_test_...) to try the full checkout -> webhook -> subscription flow
# safely; STRIPE_WEBHOOK_SECRET comes from `stripe listen` in local dev or
# the endpoint's signing secret in the Stripe Dashboard. ---
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# --- Social OAuth apps (Meta/LinkedIn/X) are NOT configured via env vars.
# They are Super-Admin-managed, database-stored, and encrypted — see
# /admin/infrastructure ("Infrastructure & Connexions"). Log in as the seeded
# Super Admin (prisma/seed.ts) and enter each app's Client ID/Secret there;
# they're immediately usable by every tenant's OAuth connect flow
# (src/server/services/oauth.service.ts) with no redeploy required. ---

# --- Encryption key for the credentials vault (GlobalIntegration) AND for
# tenant social tokens (SocialAccount) — see src/lib/crypto.ts. Required for
# both the infrastructure cockpit and any tenant OAuth connection to work;
# losing/rotating this key invalidates every stored credential. ---
TOKEN_ENCRYPTION_KEY="replace-with-a-random-32-byte-key"

# --- Scheduled-publication worker (src/app/api/cron/publish-scheduled).
# Vercel Cron (see vercel.json) automatically sends this as
# `Authorization: Bearer <CRON_SECRET>` on its own invocations — set the
# same value here and in the Vercel project's environment variables. If
# unset, the route runs unauthenticated (fine for local dev only).
CRON_SECRET=""

# --- Make Orchestration Gateway (Spec §3, §7) ---
# Global HMAC signing secret used for verifying webhooks from Make.com
# Also configurable in the Super Admin cockpit at /admin/infrastructure/make
MAKE_WEBHOOK_SECRET="replace-with-a-random-32-byte-hmac-secret"
MAKE_API_TOKEN=""
MAKE_ORGANIZATION_ID=""
MAKE_TEAM_ID=""

