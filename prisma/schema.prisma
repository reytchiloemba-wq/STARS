model DataRetentionPolicy {
  id             String   @id @default(cuid())
  organizationId String   @unique
  retentionDays  Int
  updatedAt      DateTime @updatedAt
}

model AuditLog {
  id             String   @id @default(cuid())
  organizationId String?
  actorUserId    String?
  action         String
  targetType     String?
  targetId       String?
  metadata       Json?
  createdAt      DateTime @default(now())

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actor        User?         @relation(fields: [actorUserId], references: [id])

  @@index([organizationId])
}

// Enterprise qualification form submissions (landing page §8) — a pre-signup
// prospect, not yet a tenant, so intentionally NOT organization-scoped.
model SalesLead {
  id                String   @id @default(cuid())
  company           String
  jobTitle          String
  companySize       String?
  country           String?
  email             String
  seatsNeeded       String?
  brandsNeeded      String?
  monitoringNeeds   String?
  networks          String[]
  publicationVolume String?
  securityNeeds     String?
  message           String?
  consent           Boolean  @default(false)
  createdAt         DateTime @default(now())
}

// =============================================================================
// GLOBAL INFRASTRUCTURE — Super Admin cockpit ("Infrastructure & Connexions").
//
// Everything below this line is Level A (spec §4): configured exclusively by
// isSuperAdmin users, never exposed to a tenant. No tenant-facing query may
// ever select `credentialsEnc` — see src/lib/super-admin.ts and
// src/lib/crypto.ts. Level B (tenant OAuth authorizations) lives in the
// existing `SocialAccount` model plus `OAuthState` below.
// =============================================================================

enum ProviderCategory {
  SOCIAL
  NEWS_SEARCH
  WEB_EXTRACTION
  AI
  ILLUSTRATION
  PUBLISHING
  STORAGE
}

// Static catalog entry (what STARS knows how to connect to). Seeded from
// src/config/providers.ts — that file is the source of truth, same pattern
// as src/config/pricing.ts. Never tenant-scoped: this is just a menu.
model IntegrationProvider {
  id               String           @id @default(cuid())
  key              String           @unique
  name             String
  category         ProviderCategory
  description      String?
  docsUrl          String?
  isOAuth          Boolean          @default(false)
  isPrimaryCapable Boolean          @default(true)

  integrations GlobalIntegration[]
  routingRules ProviderRoutingRule[]
}

enum IntegrationEnvironment {
  TEST
  PRODUCTION
}

enum IntegrationStatus {
  NOT_CONFIGURED
  INCOMPLETE
  TESTING
  OPERATIONAL
  DEGRADED
  QUOTA_LOW
  QUOTA_EXHAUSTED
  AUTH_EXPIRED
  ERROR
  SUSPENDED
  REVOKED
}

// A Super-Admin-configured instance of a provider. `credentialsEnc` holds an
// AES-256-GCM-encrypted JSON blob (see src/lib/crypto.ts) — the plaintext is
// NEVER stored, logged, or returned to any client after creation; only
// `credentialsFingerprint` (last 4 chars, e.g. "••••••••A7F2") is ever
// displayed. Status is only ever set to OPERATIONAL by a real test run
// (src/server/services/infrastructure.service.ts) — never optimistically.
model GlobalIntegration {
  id                     String                 @id @default(cuid())
  providerId             String
  environment            IntegrationEnvironment @default(TEST)
  status                 IntegrationStatus      @default(NOT_CONFIGURED)
  isPrimary              Boolean                @default(false)
  credentialsEnc         String?
  credentialsFingerprint String?
  config                 Json? // non-secret config: redirect URIs, scopes, region, model list…
  lastTestedAt           DateTime?
  lastTestResult         String? // 'success' | 'failure'
  lastTestMessage        String?
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt

  provider               IntegrationProvider   @relation(fields: [providerId], references: [id])
  secretVersions         SecretVersion[]
  incidents              IntegrationIncident[]
  costRecords            CostRecord[]
  routingRulesAsPrimary  ProviderRoutingRule[] @relation("RoutingPrimary")
  routingRulesAsFallback ProviderRoutingRule[] @relation("RoutingFallback")

  @@unique([providerId, environment])
}

// Append-only rotation history — never stores plaintext, only who rotated
// which integration's credentials and when (spec §18: rotation/versioning).
model SecretVersion {
  id                  String   @id @default(cuid())
  globalIntegrationId String
  fingerprint         String
  rotatedByUserId     String
  createdAt           DateTime @default(now())

  globalIntegration GlobalIntegration @relation(fields: [globalIntegrationId], references: [id], onDelete: Cascade)
  rotatedBy         User              @relation(fields: [rotatedByUserId], references: [id])

  @@index([globalIntegrationId])
}

// AI task routing (spec §14). `taskKey` matches AiTaskKey in
// src/server/services/ai-router.service.ts.
model ProviderRoutingRule {
  id         String   @id @default(cuid())
  taskKey    String
  providerId String
  primaryId  String?
  fallbackId String?
  updatedAt  DateTime @updatedAt

  provider IntegrationProvider @relation(fields: [providerId], references: [id])
  primary  GlobalIntegration?  @relation("RoutingPrimary", fields: [primaryId], references: [id])
  fallback GlobalIntegration?  @relation("RoutingFallback", fields: [fallbackId], references: [id])

  @@unique([taskKey])
}

// Tenant-side OAuth CSRF+PKCE state (spec §10, §25 test #5: "un callback
// OAuth falsifié est rejeté"). Single-use, short-lived, tenant-scoped.
model OAuthState {
  id             String        @id @default(cuid())
  state          String        @unique
  organizationId String
  userId         String
  network        SocialNetwork
  codeVerifier   String // PKCE
  redirectUri    String
  expiresAt      DateTime
  consumedAt     DateTime?
  createdAt      DateTime      @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

enum IncidentSeverity {
  INFO
  WARNING
  CRITICAL
}

// Global (not tenant-scoped) — an incident on a piece of shared
// infrastructure, e.g. "Meta App quota exhausted", affects all tenants using
// it. Tenant-caused failures belong to PublicationTarget.errorMessage instead.
model IntegrationIncident {
  id                  String           @id @default(cuid())
  globalIntegrationId String
  severity            IncidentSeverity
  message             String
  affectedTenantCount Int              @default(0)
  createdAt           DateTime         @default(now())
  resolvedAt          DateTime?

  globalIntegration GlobalIntegration @relation(fields: [globalIntegrationId], references: [id], onDelete: Cascade)

  @@index([globalIntegrationId])
}

// FinOps (spec §19). `organizationId` is nullable because some costs (a
// connectivity test run from the cockpit) aren't attributable to any tenant.
model CostRecord {
  id                  String   @id @default(cuid())
  globalIntegrationId String
  organizationId      String?
  operation           String
  costCents           Int
  createdAt           DateTime @default(now())

  globalIntegration GlobalIntegration @relation(fields: [globalIntegrationId], references: [id], onDelete: Cascade)
  organization      Organization?     @relation(fields: [organizationId], references: [id])

  @@index([globalIntegrationId])
  @@index([organizationId])
}

// =============================================================================
// MAKE ORCHESTRATION GATEWAY & FINOPS TELEMETRY
// =============================================================================

enum MakeEnvironment {
  DEVELOPMENT
  STAGING
  PRODUCTION
}

enum WorkflowType {
  MONITORING
  TOPIC_ANALYSIS
  POST_PREPARATION
  ILLUSTRATION
  PUBLICATION
  BRIEFING
  NOTIFICATION
  ANALYTICS
  COMMENT_SYNC
  COMMENT_QUALIFICATION
  COMMENT_REPLY_SUGGESTION
  CRISIS_ALERT
  COMMENT_PUBLISH_REPLY
}

enum OrchestrationMode {
  MAKE
  NATIVE
  HYBRID
}

enum ExecutionStatus {
  QUEUED
  SENT
  PROCESSING
  COMPLETED
  PARTIAL
  RETRYING
  FAILED
  CANCELLED
  DEAD_LETTERED
}

// Super-Admin Level A configuration for Make integration
model MakeConfiguration {
  id                      String            @id @default(cuid())
  environment             MakeEnvironment   @default(PRODUCTION)
  organizationIdMake      String?
  teamId                  String?
  apiTokenEnc             String?           // AES-256-GCM encrypted
  apiTokenFingerprint     String?
  webhookSigningSecretEnc String?           // HMAC secret for signature verification
  region                  String            @default("eu1")
  isEnabled               Boolean           @default(true)
  fallbackMode            OrchestrationMode @default(HYBRID)
  createdAt               DateTime          @default(now())
  updatedAt               DateTime          @updatedAt

  scenarios               MakeScenario[]
}

// Registry of Make scenarios mapped to STARS workflows
model MakeScenario {
  id               String            @id @default(cuid())
  configurationId  String
  workflow         WorkflowType      @unique
  scenarioId       String            // Make scenario ID
  scenarioName     String
  version          String            @default("v1")
  webhookUrl       String
  secretTokenEnc   String?
  isActive         Boolean           @default(true)
  isPrimary        Boolean           @default(true)
  fallbackMode     OrchestrationMode @default(HYBRID)
  timeoutMs        Int               @default(30000)
  retryLimit       Int               @default(3)
  lastTestedAt     DateTime?
  lastTestResult   String?           // 'success' | 'failure'
  lastTestMessage  String?
  averageLatencyMs Int?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  configuration    MakeConfiguration @relation(fields: [configurationId], references: [id], onDelete: Cascade)
  executions       MakeExecution[]

  @@index([configurationId])
}

// Audit trail and idempotency record of every orchestration event
model MakeExecution {
  id                 String          @id @default(cuid())
  eventId            String          @unique // UUID generated by STARS
  correlationId      String          // UUID linking related workflow steps
  idempotencyKey     String          @unique
  tenantId           String
  userId             String?
  workflow           WorkflowType
  workflowVersion    String          @default("v1")
  scenarioId         String?
  status             ExecutionStatus @default(QUEUED)
  payloadDigest      String?         // SHA-256 digest of input payload
  requestedAt        DateTime        @default(now())
  completedAt        DateTime?
  latencyMs          Int?
  attempts           Int             @default(0)
  errorMessage       String?
  deadLetteredAt     DateTime?
  sicConsumed        Int             @default(0)
  technicalCostCents Int             @default(0)

  tenant             Organization    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  scenario           MakeScenario?   @relation(fields: [scenarioId], references: [id])
  technicalCosts     TechnicalCost[]

  @@index([tenantId])
  @@index([workflow])
  @@index([status])
  @@index([correlationId])
}

// FinOps itemized cost attribution per operation
model TechnicalCost {
  id             String        @id @default(cuid())
  executionId    String?
  organizationId String
  workflow       WorkflowType
  provider       String        // 'make' | 'openai' | 'anthropic' | 'gemini' | 'brave' | 'tavily' | 'unsplash'
  unitsConsumed  Float         // Make operations / AI tokens / Search calls
  costCents      Float         // Precise cost in cents
  recordedAt     DateTime      @default(now())

  execution      MakeExecution? @relation(fields: [executionId], references: [id], onDelete: SetNull)
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([workflow])
  @@index([recordedAt])
}

// Per-tenant spending policies, threshold alerts, and emergency circuit breakers
model BudgetPolicy {
  id                  String       @id @default(cuid())
  organizationId      String       @unique
  monthlyBudgetEur    Float?
  alert50SentAt       DateTime?
  alert75SentAt       DateTime?
  alert90SentAt       DateTime?
  alert100SentAt      DateTime?
  emergencyStopActive Boolean      @default(false)
  updatedAt           DateTime     @updatedAt

  organization        Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

// =============================================================================
// STARS COMMENT INTELLIGENCE HUB (Multi-Tenant Social Inbox & Governance)
// =============================================================================

enum CommentSentiment {
  POSITIVE
  RATHER_POSITIVE
  NEUTRAL
  MIXED
  RATHER_NEGATIVE
  NEGATIVE
  UNDETERMINED
}

enum CommentCategory {
  QUESTION
  INFO_REQUEST
  COMPLIMENT
  TESTIMONIAL
  OBJECTION
  CRITICISM
  COMPLAINT
  SUPPORT_REQUEST
  BUYING_INTENT
  LEAD
  PARTNERSHIP
  JOB_APPLICATION
  MEDIA_REQUEST
  SUGGESTION
  DEBATE
  DISINFORMATION_RISK
  SPAM
  ABUSIVE
  THREAT
  LEGAL_RISK
  REPUTATION_CRISIS
  OTHER
}

enum CommentPriorityLevel {
  LOW
  NORMAL
  HIGH
  CRITICAL
}

enum CommentStatus {
  NEW
  ANALYZED
  TO_QUALIFY
  ASSIGNED
  REPLY_PREPARING
  VALIDATION_REQUIRED
  READY_TO_REPLY
  REPLIED
  WAITING_ON_CONTACT
  ESCALATED
  HIDDEN
  DELETED
  SPAM
  NO_REPLY_NEEDED
  CLOSED
  REOPENED
}

enum TeamQueue {
  COMMUNITY
  SUPPORT
  SALES
  LEGAL
  PR
  CRISIS
}

model SocialComment {
  id                  String               @id @default(cuid())
  organizationId      String
  socialAccountId     String?
  publicationId       String?
  parentCommentId     String?
  platform            SocialNetwork
  externalCommentId   String
  externalPostId      String?
  externalAuthorId    String?
  authorName          String
  authorUsername      String?
  authorAvatarUrl     String?
  content             String
  publishedAt         DateTime
  sentiment           CommentSentiment     @default(NEUTRAL)
  category            CommentCategory      @default(OTHER)
  categoryConfidence  Float                @default(0.85)
  categoryReason      String?
  priorityScore       Int                  @default(50) // 0-100
  priorityLevel       CommentPriorityLevel @default(NORMAL)
  priorityFactors     Json?
  status              CommentStatus        @default(NEW)
  assignedUserId      String?
  assignedTeam        TeamQueue            @default(COMMUNITY)
  slaDueAt            DateTime?
  slaBreached         Boolean              @default(false)
  isSensitive         Boolean              @default(false)
  repliedAt           DateTime?
  replyContent        String?
  replyAuthorId       String?
  convertedToType     String?              // 'LEAD' | 'SUPPORT_TICKET' | 'TASK' | 'CONTENT_IDEA' | 'PUBLICATION'
  convertedTargetId   String?
  postContextSummary  String?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  organization        Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  socialAccount       SocialAccount?       @relation(fields: [socialAccountId], references: [id], onDelete: SetNull)
  publication         Publication?         @relation(fields: [publicationId], references: [id], onDelete: SetNull)
  parentComment       SocialComment?       @relation("CommentThread", fields: [parentCommentId], references: [id], onDelete: SetNull)
  replies             SocialComment[]      @relation("CommentThread")
  assignedUser        User?                @relation("CommentAssignee", fields: [assignedUserId], references: [id], onDelete: SetNull)
  replyAuthor         User?                @relation("CommentReplyAuthor", fields: [replyAuthorId], references: [id], onDelete: SetNull)
  internalNotes       SocialCommentNote[]
  suggestions         SocialCommentSuggestion[]
  auditLogs           SocialCommentAudit[]

  @@unique([organizationId, platform, externalCommentId])
  @@index([organizationId])
  @@index([status])
  @@index([priorityLevel])
  @@index([platform])
  @@index([publishedAt])
}

model SocialCommentNote {
  id              String        @id @default(cuid())
  commentId       String
  authorId        String
  body            String
  createdAt       DateTime      @default(now())

  comment         SocialComment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  author          User          @relation(fields: [authorId], references: [id])

  @@index([commentId])
}

model SocialCommentSuggestion {
  id              String        @id @default(cuid())
  commentId       String
  variantKey      String        // 'short' | 'expert' | 'commercial' | 'educational' | 'empathic' | 'factual' | 'deescalation' | 'private' | 'no_reply'
  label           String
  suggestedReply  String
  tone            String?
  isAccepted      Boolean       @default(false)
  createdAt       DateTime      @default(now())

  comment         SocialComment @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@index([commentId])
}

model SocialCommentAudit {
  id              String        @id @default(cuid())
  commentId       String
  actorUserId     String?
  fromStatus      CommentStatus?
  toStatus        CommentStatus
  reason          String?
  metadata        Json?
  createdAt       DateTime      @default(now())

  comment         SocialComment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  actor           User?         @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([commentId])
}

model CrisisIncident {
  id              String           @id @default(cuid())
  organizationId  String
  title           String
  severity        IncidentSeverity @default(WARNING)
  status          String           @default("ACTIVE") // ACTIVE | RESOLVED | FALSE_ALARM
  description     String
  signalsDetected Json?
  detectedAt      DateTime         @default(now())
  resolvedAt      DateTime?

  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

model ModerationRule {
  id              String        @id @default(cuid())
  organizationId  String
  name            String
  ruleType        String        // KEYWORD_BLOCK | AUTO_HIDE | AUTO_FLAG_CRISIS | SPAM_FILTER
  pattern         String
  action          String        // HIDE | FLAG_CRITICAL | ESCALATE_LEGAL | MARK_SPAM
  isActive        Boolean       @default(true)
  createdAt       DateTime      @default(now())

  organization    Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}


